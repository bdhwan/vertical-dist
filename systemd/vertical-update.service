[Unit]
Description=Vertical OTA 받기(stage) — 뷰어에서 받아 검증·풀기·의존성까지, 서버는 건드리지 않음
# 실행 파일은 /opt/vertical/bin/update.sh — git clone 이 아니라, 설치에 성공한 릴리스의 ota/ 가 갱신한다.
# 받을 곳은 /opt/vertical/ota-source(뷰어 알림 /update/notify 가 적는다). 없으면 즉시 끝난다.
After=network.target

[Service]
Type=oneshot
User=bdhwan
ExecStart=/opt/vertical/bin/update.sh stage
# 받기는 영상보다 뒤로 — CPU·디스크 우선순위를 낮춘다(현장에서 송출 중에도 받는다).
Nice=10
IOSchedulingClass=idle
StandardOutput=append:/opt/vertical/update.log
StandardError=append:/opt/vertical/update.log
TimeoutStartSec=1800
