[Unit]
Description=Vertical OTA 업데이트 확인·적용
# 네트워크를 "기다리지" 않는다 — 인터넷이 없으면 스크립트가 즉시 종료하므로
# wait-online 으로 부팅을 지연시킬 이유가 없다.
After=network.target

[Service]
Type=oneshot
User=bdhwan
ExecStart=/opt/vertical/repo/scripts/update.sh
# 인터넷 없음/최신/촬영중은 모두 정상 종료(0)라 실패로 기록되지 않는다.
StandardOutput=append:/opt/vertical/update.log
StandardError=append:/opt/vertical/update.log
TimeoutStartSec=1800
